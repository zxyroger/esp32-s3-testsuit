/**
 * @file  secrets.h.example
 * @brief 私密配置模板 —— 复制成 secrets.h 后填入自己的值。
 *
 *     cp main/secrets.h.example main/secrets.h
 *
 * secrets.h 已在 .gitignore 里，不会被提交。没有 secrets.h 时固件仍可编译
 * （用下面 lab_secrets.h 里的占位符），但连不上 Wi-Fi、网页也解不开图像。
 */
#pragma once

/* ---------------- 家庭路由器（必须是 2.4G，ESP32-S3 不支持 5G） ---------------- */
#define SECRET_WIFI_SSID "your-2.4g-ssid"
#define SECRET_WIFI_PASS "your-wifi-password"

/* ---------------- AES-256 共享密钥（32 字节） ----------------
 * 必须与 viewer/secrets.js 里的 KEY_HEX 完全一致。
 * 生成一串随机的：
 *     python -c "import os;print(','.join('0x%02x'%b for b in os.urandom(32)))"
 * 对应前端的 hex 写法：
 *     python -c "import os;print(os.urandom(32).hex())"
 */
#define SECRET_AES_KEY_BYTES {            \
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, \
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, \
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, \
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00  \
}

/* ---------------- MQTT 主题前缀 ----------------
 * 公共 broker 上的频道名。换成你自己的随机串，别用仓库里的示例值，
 * 否则可能和别人的设备抢同一个话题。
 */
#define SECRET_MQTT_PREFIX "esp32cam/changeme00"
