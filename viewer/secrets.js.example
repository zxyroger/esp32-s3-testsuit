/* ═══════════════════════════════════════════════════════════════════════
 * 私密配置模板 —— 复制成 secrets.js 后填自己的值：
 *     cp viewer/secrets.js.example viewer/secrets.js
 * 再跑 python build.py 重新生成 index.html。
 *
 * KEY_HEX 必须和固件 main/secrets.h 里的 SECRET_AES_KEY_BYTES 一致（32 字节 → 64 hex）；
 * BASE 必须和 SECRET_MQTT_PREFIX 一致。
 *
 * 生成一对新密钥：
 *     python -c "import os;print(os.urandom(32).hex())"
 * ═══════════════════════════════════════════════════════════════════════ */
window.LAB_SECRETS = {
  KEY_HEX: '',                          /* 64 位 hex，留空则页面无法解密 */
  BASE: 'esp32cam/changeme00',          /* MQTT 主题前缀 */
};
